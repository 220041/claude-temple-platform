# 이 파일은 변수명과 설명만 기록한다. 실제 값은 절대 넣지 않는다. (guide.md 17절)
# 로컬 개발 시 이 파일을 복사해 .env.local 을 만들고 실제 값을 채운다.
#   cp .env.example .env.local

# --- Database (Supabase PostgreSQL, 개발용) ---
# Supabase Project Settings > Database > Connection string > Connection pooling (port 6543)
# Vercel 등 서버리스/엣지 배포 환경에서 커넥션 고갈을 막기 위해 pooler 주소를 사용한다.
DATABASE_URL=

# Supabase Project Settings > Database > Connection string > Direct connection (port 5432)
# 마이그레이션 실행 등 direct connection이 필요한 작업에 사용한다.
DIRECT_URL=

# --- Payload CMS ---
# 관리자 세션/토큰 서명에 사용하는 비밀값. 32자 이상의 랜덤 문자열 권장.
PAYLOAD_SECRET=

# 정적 페이지 미리보기 링크 검증 전용 값. PAYLOAD_SECRET과 반드시 다른
# 별도 랜덤 문자열을 쓴다 — 이 값은 미리보기 URL의 쿼리스트링에 그대로
# 노출되므로, 세션 토큰 서명에 쓰는 PAYLOAD_SECRET을 재사용하면 유출 시
# 로그인 위조까지 이어질 수 있다.
PAGE_PREVIEW_SECRET=

# --- Server URL ---
# 로컬: http://localhost:3000
# Preview/Production: 배포된 도메인 (공식 도메인 연결 전까지는 hanonbonglimsa.vercel.app)
NEXT_PUBLIC_SERVER_URL=

# --- 공개 회원가입 제어 (guide.md 4.2절) ---
# 공식 도메인 인증 및 Resend 실발송 검증 전까지 반드시 false 유지
PUBLIC_REGISTRATION_ENABLED=false

# --- Resend (이메일) ---
RESEND_API_KEY=
# 발신 주소. 공식 도메인 연결 전에는 Resend 테스트/개발자 지정 주소만 사용.
EMAIL_FROM=
# 개발 단계에서 인증메일 등을 실제로 수신 확인할 테스트 이메일 주소
TEST_EMAIL_RECIPIENT=

# --- Vercel Blob (이미지/파일 저장, Public/Private 분리) ---
BLOB_READ_WRITE_TOKEN_PUBLIC=
BLOB_READ_WRITE_TOKEN_PRIVATE=

# --- 카카오맵 (홈페이지 '찾아오는길' 지도) ---
# Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키.
# 브라우저에 노출되는 값이라 NEXT_PUBLIC_ 접두사를 쓰며, Kakao Developers의
# 플랫폼 설정에 등록된 도메인에서만 동작한다.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# --- Cron / 정리 작업 ---
# 고아 파일 정리, 30일 소프트 삭제 영구 정리 등 예약 작업 인증용 비밀키
CRON_SECRET=
# 주간 백업 성공/실패 결과를 받을 공통 유지보수자 이메일(사찰 super-admin
# 전원에게는 자동으로 발송됨). 미설정 시 이 수신자에게는 보내지 않는다.
BACKUP_ALERT_EMAIL=
